        "sha256": "746849f267c4868a53729225bd85c7dccd387712136fb305fcc0a3eadd4a3d9d"
      },
      "lock": {
        "resolved": "https://registry.npmjs.org/minimatch/-/minimatch-3.1.5.tgz",
        "integrity": "sha512-VgjWUsnnT6n+NUk6eZq77zeFdpW2LWDzP6zFGrCbHXiYNul5Dzqk2HHQ5uFH2DNW5Xbp8+jVzaeNt94ssEEl4w=="
      },
      "limits": [
        "Applies only to this advisory and the exact version, registry integrity and installed source hash above; it does not establish general safety of minimatch 3 or other legacy versions.",
        "The public scanner range <11.0.1 still includes 3.1.5. Raw findings and inherited parent findings must be reported, never suppressed or rewritten.",
        "Source absence, installed artifact identity and advisory mechanism require independent review before accepting this assessment."
      ]
    },
    {
      "id": "GHSA-g3hv-75wg-m249",
      "url": "https://github.com/advisories/GHSA-g3hv-75wg-m249",
      "package": "minimatch",
      "version": "11.0.3",
      "status": "fixed",
      "source": {
        "repository": "https://github.com/isaacs/minimatch",
        "commit": "b0c2aa83161cb6aaa19fa2e612f0b64edffd18ee",
        "file": "src/index.ts",
        "url": "https://github.com/isaacs/minimatch/blob/b0c2aa83161cb6aaa19fa2e612f0b64edffd18ee/src/index.ts"
      },
      "evidence": "The former parser-only 9.x resolution is scoped to 11.0.3. This implementation caps first-phase pattern growth with braceExpandMax and skips quadratic second-phase optimization for sets larger than 1000. The parser uses the compatible named minimatch(filePath, pattern) API."
    },
    {
      "id": "GHSA-3g3m-2fjr-6pw4",
      "url": "https://github.com/advisories/GHSA-3g3m-2fjr-6pw4",
      "package": "glob",
      "status": "component_not_present",
      "mechanism": "An async glob walk can continue filesystem traversal after AbortSignal cancellation.",
      "evidence": "The sole glob parent was Sucrase 3.35.0. Supported patch 3.35.1 replaces glob with tinyglobby; the lock and installed tooling guard prohibit every glob copy.",
      "replacement": {
        "package": "sucrase",
        "version": "3.35.1",
        "source": {
          "repository": "https://github.com/alangpierce/sucrase",
          "commit": "fa5b7abfb5588afc20c6c28f23a95b9e347215d7",
          "file": "src/cli.ts",
          "url": "https://github.com/alangpierce/sucrase/blob/fa5b7abfb5588afc20c6c28f23a95b9e347215d7/src/cli.ts"
        }
      }
    }
  ],
