# Copy to .env.local (gitignored) and fill in.
#
# Blockfrost mainnet project id — the site's single data provider (pool stats,
# wallet assessment, delegation tx building). Get one free at blockfrost.io.
# NEXT_PUBLIC_* = bundled into the browser; that's intentional (rate-limit-
# scoped key, standard dApp pattern). Without it the stats strip shows sample
# data and the delegate flow shows a config error.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=mainnet...
